{
  "name": "math-department-spa",
  "private": true,
  "version": "1.0.0",
  "description": "SPA Лаборатории математики ФН1: каталог учебных материалов на React + React Router + Bootstrap 5",
  "homepage": "https://sharipovaka.github.io/fs1/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "previews": "node scripts/generate-previews.mjs",
    "catalog": "node scripts/generate-catalog.mjs",
    "icon-set": "node scripts/generate-icon-set.mjs",
    "predev": "npm run icon-set && npm run catalog",
    "dev": "vite",
    "prebuild": "npm run icon-set && npm run catalog",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.11"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}
